# ─────────────────────────────────────────────────────────────────────────────
# Enably GTM Architect — environment variables
# Copy this file to .env.local and fill in what you have. EVERYTHING IS OPTIONAL:
# with nothing set, the app runs in demo mode (templates + local file store).
# Never commit .env.local — it is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI model (pick ONE) ─────────────────────────────────────────────────────
# Recommended: Vercel AI Gateway — one key, any model, automatic fallbacks.
# Get it at vercel.com → your team → AI Gateway → API keys. (On Vercel, OIDC works automatically.)
AI_GATEWAY_API_KEY=
# On Vercel: set ENABLY_AI_GATEWAY_OIDC=1 to use AI Gateway through the project's OIDC token instead of a key
# ENABLY_AI_GATEWAY_OIDC=1
# Or: direct Anthropic key from console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model overrides (defaults shown)
# ENABLY_MODEL=anthropic/claude-sonnet-5.5        # use claude-sonnet-5-5 with ANTHROPIC_API_KEY
# ENABLY_FAST_MODEL=anthropic/claude-haiku-5.5    # used for intent extraction

# ── Supabase: database + sign-in (REQUIRED on Vercel) ───────────────────────
# supabase.com → project → Settings → API (or connect the Supabase integration on Vercel,
# which sets these for you). Then run supabase/migrations/0001 … 0005 in order.
# Sign-in: Google OAuth + email/password. See docs/DEPLOY.md §2 for the Google client and
# redirect URLs (https://enablygtm.vercel.app/auth/callback + https://enablygtm-*-gptpat.vercel.app/**).
# Without these on Vercel the app stays closed ("Sign-in isn't configured").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # anon / publishable key — public by design (RLS protects data)
SUPABASE_SERVICE_ROLE_KEY=            # SECRET, server only — never prefix with NEXT_PUBLIC_
# SUPABASE_URL=                       # optional, defaults to NEXT_PUBLIC_SUPABASE_URL
ENABLY_WORKSPACE_ID=default
# Local only: with no Supabase, `next dev` signs you in as dev@localhost. For `next start`
# locally set ENABLY_DEV_AUTH=1. Ignored on Vercel.
# ENABLY_DEV_AUTH=1

# ── Observability & evals (LangSmith) ───────────────────────────────────────
# smith.langchain.com → Settings → API keys
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enablygtm
LANGSMITH_TRACING=true

# ── Durable runs (Cloudflare Agents) ────────────────────────────────────────
# URL of your deployed workers/gtm-durable worker + a long random shared secret
# (set the same secret on the worker with: npx wrangler secret put CF_AGENT_SECRET)
CF_AGENT_URL=
CF_AGENT_SECRET=
# Public URL of this app (so the durable agent can call back). Auto-detected on Vercel.
ENABLY_APP_URL=
# Hand off to the durable agent when a build runs longer than this (ms)
ENABLY_WATCHDOG_MS=45000

# ── Delivery (n8n / Make / Zapier) ──────────────────────────────────────────
# A webhook that receives approved packages. Always approval-gated in the UI.
WORKFLOW_WEBHOOK_URL=
WORKFLOW_WEBHOOK_SECRET=

# ── Optional extra gate ─────────────────────────────────────────────────────
# Sign-in protects the app. If set, signed-in users must ALSO enter this code (invite-only).
# Leave unset for normal public sign-up.
ENABLY_ACCESS_CODE=

# ── Accounts, BYOK & credits ───────────────────────────────────────────────
# 32 random bytes (base64 or hex): `openssl rand -base64 32`. Encrypts users' own AI keys
# (AES-256-GCM, bound to the user's id). Rotating it invalidates saved keys — keep it stable.
BYOK_ENCRYPTION_KEY=
# House-key metering. "on" (default): each AI call on the house key costs credits;
# users with their own key are never charged. "off": house key is free for everyone with access.
ENABLY_BILLING=on
ENABLY_CREDITS_PER_CALL=1
# One-time welcome credits per new signed-up user. Keep 0 on a public site (sign-ups are free).
ENABLY_FREE_CREDITS=0
# Optional credit packs (JSON). Default: starter 100/$5, growth 500/$20, scale 1500/$50.
# Use "priceId":"price_..." to bill a Stripe Price instead of inline amounts.
# ENABLY_CREDIT_PACKS=[{"id":"starter","label":"Starter","credits":100,"amountCents":500,"currency":"usd"}]
# Optional BYOK default models (users can override per key)
# ENABLY_BYOK_ANTHROPIC_MODEL=claude-sonnet-5-5
# ENABLY_BYOK_OPENAI_MODEL=gpt-5.5
# ENABLY_BYOK_OPENAI_FAST_MODEL=gpt-5.4-mini

# ── Credit purchases (Stripe Checkout) ─────────────────────────────────────
# dashboard.stripe.com → Developers → API keys (secret key, sk_live_… / sk_test_…)
STRIPE_SECRET_KEY=
# dashboard.stripe.com → Developers → Webhooks → add endpoint
#   https://<your-app>/api/billing/webhook  events: checkout.session.completed, checkout.session.async_payment_succeeded
# then copy its signing secret (whsec_…). On Vercel, purchases stay paused until Supabase is connected.
STRIPE_WEBHOOK_SECRET=

# ── SDR connectors (all optional; each unlocks tools in chat) ───────────────
SERPAPI_API_KEY=            # web search for research_web
JINA_API_KEY=               # optional: higher limits for the Jina reader
APOLLO_API_KEY=             # prospect_leads + enrich_contact
HUNTER_API_KEY=             # verify_email (approval-gated)
HUBSPOT_ACCESS_TOKEN=       # private-app token: find / upsert / log activity
RESEND_API_KEY=             # send_email (approval-gated)
ENABLY_SENDER_EMAIL=        # e.g. "Pat <pat@outreach.yourdomain.com>" — use a separate sending domain
ENABLY_SENDER_FOOTER=       # appended to every send: physical address + how to unsubscribe
ENABLY_DAILY_SEND_CAP=25    # max approved sends per day
ENABLY_SUPABASE_WRITABLE_TABLES=lead_snapshots

# ── MCP ─────────────────────────────────────────────────────────────────────
# Connect MCP servers to the Architect (Clay, HubSpot, Zoho, Attio, your n8n…).
# ${VAR} in headers is filled from env so tokens stay out of this JSON.
# ENABLY_MCP_SERVERS=[{"name":"clay","url":"https://<clay-mcp-url>","headers":{"Authorization":"Bearer ${CLAY_MCP_TOKEN}"}}]
ENABLY_MCP_SERVERS=
# Expose Enably itself as an MCP server at /api/mcp (off until set)
ENABLY_MCP_TOKEN=

# ── Documents, OCR, vision & transcription ─────────────────────────────────
# Built in and free: PDF, Word, PowerPoint, Excel, and image OCR (tesseract.js).
# With a model key, images and scanned PDFs are read by the model's vision instead.
ENABLY_VISION=on              # "off" forces free OCR even when a model key exists
ENABLY_OCR_LANGS=eng          # tesseract languages, e.g. "eng+spa"
# Optional: self-hosted Docling for scans, tables and complex layouts (free, MIT)
DOCLING_URL=                  # e.g. http://your-server:5001
DOCLING_API_KEY=
# Audio & video → transcript via any OpenAI-compatible Whisper endpoint
TRANSCRIBE_BASE_URL=          # self-hosted Speaches: http://your-server:8000/v1 · Groq: https://api.groq.com/openai/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo   # Speaches example: Systran/faster-whisper-small
