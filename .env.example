# ==============================================================================
# Loadsmart Live GTM Agent Operating System - Environment Variables
# ==============================================================================

# Pod Copilot (/copilot) model route - pick ONE
# Route A: Vercel AI Gateway. On Vercel it works with no key (project OIDC token).
# Locally, create a key in Vercel > AI Gateway > API Keys.
AI_GATEWAY_API_KEY=""
AI_MODEL="anthropic/claude-sonnet-5.5"
# Route B: Anthropic directly (takes priority when ANTHROPIC_API_KEY below is set)
# ANTHROPIC_MODEL="claude-sonnet-5-5"
# Public demo protection: max copilot messages per IP per hour
CHAT_RATE_LIMIT_PER_HOUR=40
# Scheduler (Cloudflare Worker -> /api/pipeline/run). Long random string; same value in wrangler secret.
CRON_SECRET=""

# AI Brain & Multi-Model Providers (Optional in Demo Mode)
# The system runs out-of-the-box in deterministic demo mode if no keys are provided.
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Supabase (Postgres & Auth with RLS - Optional in Demo Mode)
# If omitted, the app persists to .data/loadsmart-gtm.json automatically.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare Durable Agent / Worker URL (Optional)
CF_AGENT_URL=""
CF_AGENT_SECRET=""

# Automation Webhook Endpoints (n8n, Make.com, Gong, Amplemarket)
N8N_WEBHOOK_URL=""
GONG_WEBHOOK_URL=""
CLAY_WEBHOOK_URL=""

# Observability
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="loadsmart-gtm-agent"

