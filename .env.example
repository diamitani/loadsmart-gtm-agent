# ==============================================================================
# Loadsmart Live GTM Agent Operating System - Environment Variables
# ==============================================================================

# AI Brain & Multi-Model Providers (Optional in Demo Mode)
# The system runs out-of-the-box in deterministic demo mode if no keys are provided.
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Supabase (Postgres & Auth with RLS - Optional in Demo Mode)
# If omitted, the app persists to .data/loadsmart-gtm.json automatically.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare Durable Agent / Worker URL (Optional)
CF_AGENT_URL=""
CF_AGENT_SECRET=""

# Automation Webhook Endpoints (n8n, Make.com, Gong, Amplemarket)
N8N_WEBHOOK_URL=""
GONG_WEBHOOK_URL=""
CLAY_WEBHOOK_URL=""

# Observability
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="loadsmart-gtm-agent"

