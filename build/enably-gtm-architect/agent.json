  "capabilities": [
    {
      "id": "build-package",
      "description": "PAL pipeline: intake → intent → foundation (W gate) → instruct → plan → build → test → present.",
      "workflow_steps": [
        "Read the request, files and links",
        "Check required inputs (offer, ICP, deliverable); ask if missing",
        "Build each asset with its skill specialist, in DAG waves",
        "Truth-check and quality-gate the package",
        "Present the package and one next action, and save it to the Library"
      ],
      "guardrails": [
        "Never invent contact details, dates, or numbers",
        "Do not build below W = 1.00"
      ]
    },
    {
      "id": "revise-and-operate",
      "description": "Chat over an existing package: revise assets, search knowledge, SDR research, templates, approval-gated sends and CRM writes.",
      "workflow_steps": [
        "Read the current package with list_artifacts / get_artifact",
        "Do the work with tools",
        "Ask for approval before any external write or send",
        "Save new versions to the Library"
      ],
      "guardrails": [
        "Never pretend a tool call happened"
      ]
    }
