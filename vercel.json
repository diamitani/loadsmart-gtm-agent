{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    }
  },
  "environmentVariables": {
    "SUPABASE_URL": {
      "fromSecret": "SUPABASE_URL"
    },
    "SUPABASE_SERVICE_ROLE_KEY": {
      "fromSecret": "SUPABASE_SERVICE_ROLE_KEY"
    },
    "ENABLY_WORKSPACE_ID": {
      "value": "default"
    },
    "NODE_ENV": {
      "value": "production"
    }
  },
  "env": {
    "SUPABASE_URL": "",
    "SUPABASE_SERVICE_ROLE_KEY": ""
  }
}
