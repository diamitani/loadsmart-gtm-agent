{
  "name": "loadsmart-gtm",
  "version": "1.0.0",
  "private": true,
  "description": "Loadsmart Live GTM Sovereign Agent OS — Internal ABM Pod Copilot, GTM Automation Engine & COE",
  "type": "module",
  "scripts": {
    "bundle-kit": "node scripts/bundle-kit.mjs",
    "prebuild": "node scripts/bundle-kit.mjs",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx --conditions=react-server --tsconfig tsconfig.json evals/run.ts",
    "cf:dev": "npm --prefix workers/gtm-durable run dev",
    "cf:deploy": "npm --prefix workers/gtm-durable run deploy",
    "forge:validate": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/forge.ts validate",
    "forge:build": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/forge.ts build",
    "forge:check": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/forge.ts check"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/gateway": "^4.0.138",
    "@ai-sdk/google": "^4.0.118",
    "@ai-sdk/mcp": "^2.0.93",
    "@ai-sdk/openai": "^4.0.111",
    "@ai-sdk/react": "^4.0.169",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "ai": "^7.0.165",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "langsmith": "^0.11.8",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "unpdf": "^2.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
